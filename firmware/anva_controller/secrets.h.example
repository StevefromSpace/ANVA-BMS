// Copy to secrets.h (git-ignored) and fill in. NEVER commit secrets.h.
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-pass"
#define MQTT_HOST "broker.example.com"
#define MQTT_PORT 8883
#define MQTT_USER ""
#define MQTT_PASS ""
// esp32_01 = DevKit V1 (relays 1-16), esp32_02 = ESP32-S3 (relays 17-32)
#define CONTROLLER_ID "esp32_01"
#define FIRST_RELAY 1          // 17 for esp32_02
#define HAS_AC false           // true only on esp32_02 (relay 32 = AC contactor request)
// Board config in boards/: BOARD_ESP32_DEVKIT_V1 (esp32_01) or BOARD_ESP32S3_N16R8 (esp32_02). Pin values there are UNVERIFIED.
#define BOARD BOARD_ESP32_DEVKIT_V1
// OWNER POLICY DECISION: on Wi-Fi/MQTT loss lighting keeps its last state; the AC request relay drops OFF after this many ms.
// 0 disables the timeout (AC then stays on through a comms loss; protection inputs still trip it locally).
#define AC_COMMS_LOSS_OFF_MS 600000UL

// PEM of the CA that signed the broker certificate. Firmware REFUSES to connect while this is empty.
// Paste the PEM as adjacent string literals, one per line, e.g.:
//   "-----BEGIN CERTIFICATE-----\n"
//   "MIIF...\n"
//   "-----END CERTIFICATE-----\n"
#define BROKER_CA_CERT ""
