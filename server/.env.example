MQTT_URL=mqtts://broker.example.com:8883
MQTT_USER=
MQTT_PASS=
BUILDING_ID=building001
PORT=8787
HOST=127.0.0.1
# Required: HMAC key for session tokens (32+ random bytes, hex). Rotate per docs/SECURITY.md.
SESSION_SECRET=
# Users: node server/users-cli.js add <name> <role>  (stored in git-ignored server/users.json)
# Local dev ONLY: anonymous viewer access (BRIDGE_DEV_OPERATOR=1 makes it operator).
BRIDGE_ALLOW_ANON=
# TLS for remote use: TLS_CERT_FILE= TLS_KEY_FILE= MQTT_CA_FILE=
# Scheduler (off by default, dry-run default): SCHEDULER_ENABLED=0 SCHEDULER_TZ= SCHEDULER_DRY_RUN=1 MISSED_GRACE_MS=0
# Comma-separated browser Origins allowed to connect (default: Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
